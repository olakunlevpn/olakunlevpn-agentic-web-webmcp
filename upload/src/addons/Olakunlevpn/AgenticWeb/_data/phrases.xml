  <phrase title="option_explain.ol_agentic_web_a11y_labels" version_id="1000370" version_string="1.0.3"><![CDATA[Adds clear labels to icon-only buttons, menus, and links so AI agents and screen readers understand what each control does.]]></phrase>
  <phrase title="option_explain.ol_agentic_web_a11y_live" version_id="1000370" version_string="1.0.3"><![CDATA[Notifies AI agents about real-time updates (like live statistics and alerts) without needing a full page reload.]]></phrase>
  <phrase title="option_explain.ol_agentic_web_ad_min_height" version_id="1000370" version_string="1.0.3"><![CDATA[Space kept ready for banner ads so the page does not jump down when ads finish loading.]]></phrase>
  <phrase title="option_explain.ol_agentic_web_anticls_enable" version_id="1000370" version_string="1.0.3"><![CDATA[Reserves space for ads and dynamic widgets so the page does not jump or shift while loading.]]></phrase>
  <phrase title="option_explain.ol_agentic_web_ard_enable" version_id="1000370" version_string="1.0.3"><![CDATA[Publishes an ard.json catalog and links it in robots.txt so AI crawlers can discover your forum tools.]]></phrase>
  <phrase title="option_explain.ol_agentic_web_ard_queries" version_id="1000370" version_string="1.0.3"><![CDATA[Example search queries (one per line) to help AI search engines match user questions to your forum topics. 2 to 5 recommended.]]></phrase>
  <phrase title="option_explain.ol_agentic_web_enable" version_id="1000370" version_string="1.0.3"><![CDATA[Master switch for all AI agent tools, llms.txt endpoints, accessibility enhancements, and layout stabilization.]]></phrase>
  <phrase title="option_explain.ol_agentic_web_llms_include_rules" version_id="1000370" version_string="1.0.3"><![CDATA[Appends your forum rules and terms to llms.txt so visiting AI agents follow community guidelines.]]></phrase>
  <phrase title="option_explain.ol_agentic_web_llmstxt_enable" version_id="1000370" version_string="1.0.3"><![CDATA[Generates clean Markdown files at /llms.txt and /llms-full.txt to help AI crawlers index your forum efficiently.]]></phrase>
  <phrase title="option_explain.ol_agentic_web_mcp_enable" version_id="1000370" version_string="1.0.3"><![CDATA[Lets AI agents in modern browsers (like Chrome AI, Gemini, and Claude) search discussions and read public threads.]]></phrase>
  <phrase title="option_explain.ol_agentic_web_rate_limit" version_id="1000370" version_string="1.0.3"><![CDATA[Maximum requests per minute per IP address to protect your server from aggressive AI traffic.]]></phrase>
  <phrase title="option_explain.ol_agentic_web_site_summary" version_id="1000370" version_string="1.0.3"><![CDATA[A short introduction to your forum for AI visitors via llms.txt. Leave empty to use your default board title and description.]]></phrase>
